{
  "name": "@teampulse/bs-calendar",
  "version": "0.1.0",
  "description": "Bikram Sambat (Nepali) calendar for TeamPulse: BS<->AD conversion, fiscal years, Kathmandu time. Year-specific month tables, never formula-based.",
  "type": "module",
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "node scripts/generate-data.mjs",
    "test": "node --test test/*.test.ts",
    "sql": "node scripts/generate-sql.ts > ../../db/seed/00_bs_calendar.sql"
  },
  "devDependencies": {
    "bikram-sambat": "1.8.1",
    "nepali-date-converter": "3.4.0"
  },
  "engines": { "node": ">=22.18" }
}
