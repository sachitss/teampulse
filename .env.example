# TeamPulse — environment template. Copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or the agent. Used to send invitations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Supabase → Connect → Transaction pooler, port 6543) ---
# The server runs every query as the signed-in person (role authenticated + their claims),
# so Row Level Security decides access exactly as it would through Supabase's API.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10

# --- Local development only. NEVER set these in Vercel / production. ---
# Enables /dev-login to sign in as any demo user. Ignored by production builds.
# TP_DEV_AUTH=1
# TP_DEV_AUTH_SECRET=   (at least 32 random characters: openssl rand -hex 32)

# --- Encryption of PAN, bank account and SSF numbers (AES-256-GCM, done in the app) ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing this key makes those fields unreadable. Store a copy offline with the director.
PII_ENCRYPTION_KEY=

# --- Agent tokens ---
# Extra secret mixed into device-token and enrollment-code hashes. openssl rand -base64 32
AGENT_TOKEN_PEPPER=

# --- Email (Resend or Postmark), sending from PEACE's own domain with SPF + DKIM ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
REPORT_FROM="TeamPulse <reports@your-domain.com.np>"

# --- App ---
APP_BASE_URL=https://teampulse.your-domain.com.np
TZ=UTC   # the server runs in UTC; Kathmandu time is applied in code and SQL
