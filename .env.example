# TeamPulse — settings for the NAS. Copy to `.env` next to docker-compose.yml and fill in.
# NEVER commit or share the real file. Keep a printed/offline copy with the director:
# losing ENCRYPTION_KEY makes two-factor secrets (and later PAN/bank numbers) unreadable.
#
# Generate each secret on any computer with:   openssl rand -hex 32
# (hex only — letters a–f and digits — so nothing breaks inside the database address)

# --- Address people will use (the Cloudflare Tunnel public hostname), https only ---
APP_BASE_URL=https://teampulse.medtec24.com

# --- Database passwords (two different values) ---
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# --- Encryption key: 32 random bytes, base64 —  openssl rand -base64 32 ---
ENCRYPTION_KEY=

# --- Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker) ---
TUNNEL_TOKEN=

# --- Email (optional). Without it, invitation and reset links are shown to the admin to hand over. ---
# Any SMTP service works: Synology MailPlus, Google Workspace (smtp.gmail.com + app password),
# Zoho, Microsoft 365. Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TeamPulse <teampulse@your-domain.com.np>"

# --- Optional ---
# Pin a version instead of the newest build, e.g. TEAMPULSE_VERSION=2026.10.29
TEAMPULSE_VERSION=latest
BACKUP_KEEP_DAYS=30
